{
  "name": "flashcards-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro build --outDir dist-local && wrangler dev --config dist-local/server/wrangler.json --local --ip 127.0.0.1 --port 4335 --persist-to .wrangler/state",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:migration:imp003": "node scripts/rehearse-imp003.mjs",
    "db:local": "npm run db:migrate:local",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy --keep-vars",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "test:e2e": "node scripts/run-e2e.mjs",
    "db:e2e": "wrangler d1 migrations apply DB --local --persist-to .wrangler/v3-e2e",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "db:status:local": "wrangler d1 migrations list DB --local --persist-to .wrangler/state",
    "db:reset:local": "node scripts/reset-local.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@astrojs/react": "7.1.9",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@supabase/supabase-js": "^2.119.2",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "7.4.13",
    "jose": "^6.2.18",
    "prismjs": "1.30.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "^4.0.0",
    "yaml": "^2.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@cloudflare/workers-types": "5.20261121.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "miniflare": "5.20261117.0-beta",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "wrangler": "4.164.0"
  }
}
